    USER {
        string id PK
        string name
        string username UK "nullable"
        string email UK
        string avatar "nullable"
        string bio "nullable"
        string location "nullable"
        string school "nullable"
        decimal coins
        string wallet "nullable"
        decimal hourlyRate "nullable"
        string clerkId UK
        boolean onboarded
        datetime createdAt
        datetime updatedAt
    }
    
    SKILL {
        string id PK
        string name UK
        string description "nullable"
    }
    
    USER_SKILL {
        string id PK
        string type
        string userId FK
        string skillId FK
    }
    
    STUDY_ROOM {
        string id PK
        string title
        string description "nullable"
        enum sessionStatus
        datetime date
        int duration
        int maxParticipants
        string createdById FK
        decimal joiningFee
        boolean reviewReminded
        boolean reminder24hSent
        boolean reminder1hSent
        boolean reminder5mSent
        string gmeetLink "nullable"
    }
    
    STUDY_ROOM_PARTICIPANT {
        string id PK
        string userId FK
        string studyRoomId FK
    }
    
    STUDY_ROOM_SKILL {
        string id PK
        string studyRoomId FK
        string skillId FK
    }
    
    PEER_SESSION {
        string id PK
        string title
        string description "nullable"
        enum sessionStatus
        datetime date
        int duration
        string requestedById FK
        string requestedToId FK
        boolean reviewReminded
        boolean reminder24hSent
        boolean reminder1hSent
        boolean reminder5mSent
        string gmeetLink "nullable"
    }
    
    PEER_SESSION_SKILL {
        string id PK
        string peerSessionId FK
        string skillId FK
    }
    
    PAYMENT {
        string id PK
        enum paymentStatus
        string madeById FK
        string receivedById FK
        string studyRoomId FK "nullable"
        string peerSessionId FK "nullable"
        decimal amountMade
        decimal amountReceived "nullable"
        decimal amountRefunded "nullable"
        datetime createdAt
        string transactionHash "nullable"
        string network "nullable"
    }
    
    REVIEW {
        string id PK
        int rating
        string review
        string reviewerId FK
        string revieweeId FK
        string peerSessionId FK "nullable"
        string studyRoomId FK "nullable"
    }
    
    NOTIFICATION {
        string id PK
        enum notifType
        string message
        datetime createdAt
        boolean viewed
        string userId FK
        string actionType "nullable"
        string actionData "nullable"
        string peerSessionId FK "nullable"
        string studyRoomId FK "nullable"
    }
    
    PUSH_SUBSCRIPTION {
        string id PK
        string userId FK
        string endpoint
        string p256dh
        string auth
        datetime createdAt
        datetime updatedAt
    }
    
    METRICS {
        string id PK
        string name
        float value
        string description "nullable"
        string userId FK
    }
    
    CHANNEL {
        string id PK
        string name
        boolean isDirect
        datetime createdAt
        string externalType "nullable"
        string externalId "nullable"
    }
    
    CHANNEL_MEMBER {
        string id PK
        string channelId FK
        string userId FK
    }
    
    MESSAGE {
        string id PK
        string channelId FK
        string senderId FK
        string content
        datetime createdAt
    }
