		{
			"name": "https://be.test.webyalaya.com/api/stats/platform",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response is JSON\", function () {\r",
							"    pm.response.to.be.json;\r",
							"});\r",
							"\r",
							"pm.test(\"Platform stats keys exist\", function () {\r",
							"    const res = pm.response.json();\r",
							"    pm.expect(res).to.have.property(\"usersOnboarded\");\r",
							"    pm.expect(res).to.have.property(\"studyRoomsHosted\");\r",
							"    pm.expect(res).to.have.property(\"sessionsCompleted\");\r",
							"    pm.expect(res).to.have.property(\"learningHours\");\r",
							"    pm.expect(res).to.have.property(\"reviewsGiven\");\r",
							"});\r",
							"\r",
							"pm.test(\"All stats values are numbers\", function () {\r",
							"    const res = pm.response.json();\r",
							"    Object.values(res).forEach(value => {\r",
							"        pm.expect(value).to.be.a(\"number\");\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
