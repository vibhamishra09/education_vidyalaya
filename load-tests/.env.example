WS_URL=http://localhost:3001

# Required: paste a real study room ID from your app
STUDY_ROOM_ID=your-study-room-id-here

# Required for real backend: paste a Clerk session JWT from browser devtools.
# Open DevTools → Application → Cookies → __session  (on your app's domain)
# All virtual users share this token — enough for load testing.
TEST_AUTH_TOKEN=your-clerk-session-jwt-here

# Test scale
TOTAL_USERS=100
RAMP_UP_TIME=10
TEST_DURATION=60

SESSION_TYPE=studyRoom

# Optional: for chat-heavy scenario
CHAT_CHANNEL_ID=your-chat-channel-id-here

# Optional: Clerk credentials to generate real auth tokens
# Leave blank to use mock tokens (fine for most load tests)
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: specific test user IDs (comma-separated)
# TEST_USER_IDS=user_abc,user_def
