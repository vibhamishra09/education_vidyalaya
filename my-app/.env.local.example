# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# API Configuration
# Browser/client: point at Nest (port 3001). If you use the same origin as Next (3000), rely on next.config rewrites.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side rewrites + onboarding Route Handler: must match your Nest base URL (see next.config.ts).
BACKEND_URL=http://127.0.0.1:3001

# Clerk URLs (optional - defaults work for most cases)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

NEXT_PUBLIC_CHAT_WS_URL=http://localhost:3001
NEXT_PUBLIC_LIVEKIT_WS_URL=wss://your-unique-livekit.livekit.cloud

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX