# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# API Configuration
# Browser/client: point at Nest (port 3001). If you use the same origin as Next (3000), rely on next.config rewrites.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side rewrites: must match your Nest base URL (see next.config.ts).
BACKEND_URL=http://127.0.0.1:3001

# Clerk URLs (optional - defaults work for most cases)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

NEXT_PUBLIC_CHAT_WS_URL=http://localhost:3001
# Chat pipeline: append lines (including message text) to my-app/logs/chat-flow.txt (dev API; see CHAT_FLOW_LOG_API)
# NEXT_PUBLIC_CHAT_FLOW_FILE=1
# Allow /api/dev/chat-flow-log when NODE_ENV is not development (e.g. staging)
# CHAT_FLOW_LOG_API=1

NEXT_PUBLIC_LIVEKIT_WS_URL=wss://your-unique-livekit.livekit.cloud
# Krisp: only loaded for *.livekit.cloud (unless you allowlist hosts below). Self-hosted LiveKit has no /settings → 404 if misconfigured.
# NEXT_PUBLIC_LIVEKIT_KRISP_ENABLED=false
# Self-hosted Krisp only if your server implements GET https://<host>/settings (rare):
# NEXT_PUBLIC_LIVEKIT_KRISP_ENABLED=true
# NEXT_PUBLIC_LIVEKIT_KRISP_ALLOW_HOSTS=livekit.example.com

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Chat desync timeline (client → `logs/chat-sync-debug.ndjson` in dev via `/api/dev/chat-sync-log`)
# NEXT_PUBLIC_CHAT_SYNC_LOG=1
# Optional: allow the log API when NODE_ENV is not development (e.g. staging)
# CHAT_SYNC_LOG_API=1