# Database
DATABASE_URL="postgresql://username:password@localhost:5432/webyalaya?schema=public"

# Clerk Authentication
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CLERK_WEBHOOK_SECRET="whsec_..."

# Application
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001

# Push Notifications (Web Push)
VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_SUBJECT="mailto:your-email@example.com"

LIVEKIT_URL=wss://your-unique-livekit.livekit.cloud
LIVEKIT_API_KEY="livekit_api..."
LIVEKIT_API_SECRET="livekit_api_secret..."

AWS_REGION="your-aws-region..."
AWS_ACCESS_KEY_ID="access_key_id..."
AWS_SECRET_ACCESS_KEY="secret_access_key..."
AWS_S3_BUCKET_NAME="s3_bucket_name..."

# Redis
REDIS_URL="rediss://default:your_redis_password@your_redis_host:your_redis_port"

# Gemini AI for meeting summaries
GEMINI_API_KEY="your_gemini_api_key_here"

# Sentry Error Tracking
SENTRY_DSN="https://your-sentry-dsn@sentry.io/your-project-id"
SENTRY_RELEASE="webyalaya-backend@1.0.0"
