# Prometheus Configuration
PROMETHEUS_PORT=9090

# Backend URL for Prometheus to scrape metrics from
BACKEND_URL=be.test.webyalaya.com
BACKEND_PROTOCOL=https

# Grafana Configuration
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=WebyalayaAdmin123@
GRAFANA_ALLOW_SIGNUP=false

# Grafana Root URL - where users access Grafana
# Update with your EC2 public IP or monitoring domain
GRAFANA_ROOT_URL=http://your-ec2-public-ip:3002
# or use domain: https://monitoring.webyalaya.com

# Grafana Alerting
GRAFANA_ALERTING_ENABLED=true
GRAFANA_UNIFIED_ALERTING=true

