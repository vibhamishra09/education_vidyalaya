{
  "dashboard": {
    "title": "API Health Monitor - All Endpoints",
    "tags": ["api", "health", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "📊 Endpoint Health Status",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 12
        },
        "targets": [
          {
            "expr": "sum by (method, route) (rate(http_request_duration_seconds_count[5m]))",
            "format": "table",
            "instant": true,
            "legendFormat": "Traffic",
            "refId": "A"
          },
          {
            "expr": "1000 * (sum by (method, route) (rate(http_request_duration_seconds_sum[5m])) / sum by (method, route) (rate(http_request_duration_seconds_count[5m])))",
            "format": "table",
            "instant": true,
            "legendFormat": "Avg Response Time",
            "refId": "B"
          },
          {
            "expr": "100 * (sum by (method, route) (rate(http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / sum by (method, route) (rate(http_request_duration_seconds_count[5m])))",
            "format": "table",
            "instant": true,
            "legendFormat": "Error Rate",
            "refId": "C"
          },
          {
            "expr": "sum by (method, route) (rate(http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) > 0",
            "format": "table",
            "instant": true,
            "legendFormat": "Has Errors",
            "refId": "D"
          }
        ],
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "indexByName": {
                "method": 0,
                "route": 1,
                "Value #A": 2,
                "Value #B": 3,
                "Value #C": 4,
                "Value #D": 5
              },
              "renameByName": {
                "method": "Method",
                "route": "Endpoint",
                "Value #A": "Traffic (req/s)",
                "Value #B": "Avg Response (ms)",
                "Value #C": "Error Rate (%)",
                "Value #D": "Status"
              }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Method"
              },
              "properties": [
                {
                  "id": "custom.width",
                  "value": 100
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Traffic (req/s)"
              },
              "properties": [
                {
                  "id": "decimals",
                  "value": 2
                },
                {
                  "id": "custom.width",
                  "value": 150
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Avg Response (ms)"
              },
              "properties": [
                {
                  "id": "decimals",
                  "value": 1
                },
                {
                  "id": "custom.width",
                  "value": 180
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "yellow",
                        "value": 500
                      },
                      {
                        "color": "red",
                        "value": 1000
                      }
                    ]
                  }
                },
                {
                  "id": "custom.displayMode",
                  "value": "color-background"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Error Rate (%)"
              },
              "properties": [
                {
                  "id": "decimals",
                  "value": 2
                },
                {
                  "id": "custom.width",
                  "value": 150
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "yellow",
                        "value": 1
                      },
                      {
                        "color": "red",
                        "value": 5
                      }
                    ]
                  }
                },
                {
                  "id": "custom.displayMode",
                  "value": "color-background"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Status"
              },
              "properties": [
                {
                  "id": "custom.width",
                  "value": 100
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  }
                },
                {
                  "id": "custom.displayMode",
                  "value": "color-background"
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "1": {
                          "text": "🚨 ERROR"
                        }
                      }
                    },
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "✅ OK"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "id": 2,
        "title": "⚡ Total Request Rate",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(rate(http_request_duration_seconds_count[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "🕒 Avg Response Time",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 12,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "1000 * (sum(rate(http_request_duration_seconds_sum[5m])) / sum(rate(http_request_duration_seconds_count[5m])))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 500
                },
                {
                  "color": "red",
                  "value": 1000
                }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "❌ Total 5xx Errors (Last Hour)",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 12,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(increase(http_request_duration_seconds_count{status_code=~\"5..\"}[1h]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "✅ Success Rate",
        "type": "stat",
        "gridPos": {
          "x": 18,
          "y": 12,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "100 * (sum(rate(http_request_duration_seconds_count{status_code!~\"5..\"}[5m])) / sum(rate(http_request_duration_seconds_count[5m])))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 95
                },
                {
                  "color": "green",
                  "value": 99
                }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "📈 Response Time by Endpoint (5m avg)",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "1000 * (sum by (route) (rate(http_request_duration_seconds_sum[5m])) / sum by (route) (rate(http_request_duration_seconds_count[5m])))",
            "legendFormat": "{{route}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 7,
        "title": "🚨 Error Rate by Endpoint (%)",
        "type": "timeseries",
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "100 * (sum by (route) (rate(http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / sum by (route) (rate(http_request_duration_seconds_count[5m])))",
            "legendFormat": "{{route}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            }
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}
