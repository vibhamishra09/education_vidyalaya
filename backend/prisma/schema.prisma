generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  username              String?                @unique
  email                 String                 @unique
  avatar                String?
  bio                   String?
  location              String?
  school                String?
  coins                 Decimal                @db.Decimal(36, 16) @default(0)
  wallet                String?                // Hedera wallet address
  hourlyRate            Decimal?               @db.Decimal(36, 16)
  clerkId               String                 @unique
  createdAt             DateTime               @default(now())
  onboarded             Boolean                @default(false)
  updatedAt             DateTime               @updatedAt
  // Social media profile links (flexible JSON structure)
  // Format: [{ "platform": "linkedin", "url": "..." }, { "platform": "custom", "label": "My Blog", "url": "..." }]
  socialLinks           Json?
  // Availability settings (Users available 24/7 by default)
  bufferTime            Int                    @default(0) // Minutes between sessions (0 = back-to-back allowed)
  minAdvanceTime        Int                    @default(0) // Minimum minutes before booking (0 = instant booking)
  maxFutureBooking      Int                    @default(365) // Maximum days in future for booking
  // Streak tracking
  currentStreak         Int                    @default(0)
  longestStreak         Int                    @default(0)
  lastActivityDate      DateTime?
  timezone              String                 @default("UTC")
  metrics               Metrics?
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  paymentsMade          Payment[]              @relation("PaymentsMade")
  paymentsReceived      Payment[]              @relation("PaymentsReceived")
  peerSessionsRequested PeerSession[]          @relation("RequestedBy")
  peerSessionsReceived  PeerSession[]          @relation("RequestedTo")
  reviewsReceived       Review[]               @relation("ReviewsReceived")
  reviewsWritten        Review[]               @relation("ReviewsWritten")
  studyRooms            StudyRoom[]            @relation("UserOwnsStudyRooms")
  participating         StudyRoomParticipant[]
  userSkills            UserSkill[]
  channelMemberships ChannelMember[]
  messagesSent       Message[]
  messagesTargeted   Message[]               @relation("TargetedMessages")
  availability          UserAvailability[]
  blockedSlots          BlockedTimeSlot[]
  achievements          UserAchievement[]
  dailyActivities       DailyActivity[]
  sessionFeedbacks      SessionFeedback[]
  // Debate Room relations
  debateRoomsHosted     DebateRoom[]           @relation("DebateRoomHost")
  debateParticipations  DebateParticipant[]    @relation("DebateParticipant")
  debateModeratorRoles  DebateModerator[]      @relation("DebateModerator")
  debateChatMessages    DebateChatMessage[]    @relation("DebateChatMessages")
  debateModeratorEvaluations DebateModeratorEvaluation[] @relation("DebateModeratorEvaluations")
  peerSessionsLastEdited      PeerSession[]          @relation("PeerSessionLastEditor")
}

model StudyRoom {
  id              String                 @id @default(cuid())
  title           String
  description     String?
  imageUrl        String?
  sessionStatus   SessionStatus
  isRecurring     Boolean                @default(false)
  recurrenceMode  StudyRoomRecurrenceMode?
  seriesId        String?
  seriesRootId    String?
  occurrenceIndex Int?
  recurrenceEndDate DateTime?
  occurrenceDateLocal DateTime?
  timezone        String?
  /// STANDARD = interactive study room; WEBINAR = host-led, large audience, restricted attendee A/V
  sessionMode             StudyRoomSessionMode @default(STANDARD)
  /// Host-defined registration fields, chat/mic/video/screen defaults (JSON)
  webinarConfig           Json?
  /// Public URL segment for `/webinar/register/[slug]` (unique per room)
  webinarRegistrationSlug String?                @unique
  date            DateTime
  duration        Int
  maxParticipants Int
  createdById     String
  joiningFee      Decimal                @db.Decimal(36, 16) @default(0)
  reviewReminded  Boolean                @default(false)
  reminder24hSent Boolean                @default(false)
  reminder1hSent  Boolean                @default(false)
  reminder5mSent  Boolean                @default(false)
  slug String? 
  gmeetLink       String?
  summary         String?                @db.Text
  /// Host saved participant-visible details — enrollees see “Edited” + get a notification.
  hostDetailsUpdatedAt DateTime?
  payments        Payment[]              @relation("StudyRoomPayments")
  reviews         Review[]               @relation("StudyRoomReviews")
  notifications   Notification[]
  createdBy       User                   @relation("UserOwnsStudyRooms", fields: [createdById], references: [id])
  learners        StudyRoomParticipant[]
  guestParticipants StudyRoomGuestParticipant[]
  guestAccessTokens StudyRoomGuestAccessToken[]
  skills          StudyRoomSkill[]
  feedbacks       SessionFeedback[]
  webinarRegistrations WebinarRegistration[]
  recordings          Recording[]


  @@index([createdById])
  @@index([sessionStatus, date])
  @@index([seriesId, date])
  @@index([seriesId, occurrenceIndex])
  @@index([seriesId, sessionStatus, date])
  @@index([slug])
}

model PeerSession {
  id            String             @id @default(cuid())
  title         String
  description   String?
  sessionStatus SessionStatus
  date          DateTime
  duration      Int
  requestedById String
  requestedToId String
  reviewReminded Boolean           @default(false)
  reminder24hSent Boolean          @default(false)
  reminder1hSent  Boolean          @default(false)
  reminder5mSent  Boolean          @default(false)
  gmeetLink     String?
  summary       String?            @db.Text
  /// Last time either party saved meeting details; other party sees banner + notification.
  hostDetailsUpdatedAt DateTime?
  lastDetailsEditedById String?
  lastDetailsEditedBy   User?              @relation("PeerSessionLastEditor", fields: [lastDetailsEditedById], references: [id], onDelete: SetNull)
  payments      Payment[]          @relation("PeerSessionPayments")
  notifications Notification[]
  requestedBy   User               @relation("RequestedBy", fields: [requestedById], references: [id])
  requestedTo   User               @relation("RequestedTo", fields: [requestedToId], references: [id])
  skills        PeerSessionSkill[]
  reviews       Review[]           @relation("PeerSessionReviews")
  feedbacks     SessionFeedback[]

  @@index([requestedToId])
  @@index([requestedById])
  @@index([sessionStatus, date])
}

model Metrics {
  id          String  @id @default(cuid())
  name        String
  value       Float
  description String?
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id])
}

model Payment {
  id             String        @id @default(cuid())
  paymentStatus  PaymentStatus
  madeById       String
  receivedById   String
  studyRoomId    String?
  peerSessionId  String?
  amountMade     Decimal                @db.Decimal(36, 16)
  amountReceived Decimal?               @db.Decimal(36, 16)
  amountRefunded Decimal?               @db.Decimal(36, 16)
  createdAt      DateTime               @default(now())
  transactionHash String?
  network         String?
  madeBy         User          @relation("PaymentsMade", fields: [madeById], references: [id])
  peerSession    PeerSession?  @relation("PeerSessionPayments", fields: [peerSessionId], references: [id], map: "Payment_peerSessionId_fkey1")
  receivedBy     User          @relation("PaymentsReceived", fields: [receivedById], references: [id])
  studyRoom      StudyRoom?    @relation("StudyRoomPayments", fields: [studyRoomId], references: [id], map: "Payment_studyRoomId_fkey1")
}

model Review {
  id            String       @id @default(cuid())
  rating        Int
  review        String
  reviewerId    String
  revieweeId    String
  peerSessionId String?
  studyRoomId   String?
  peerSession   PeerSession? @relation("PeerSessionReviews", fields: [peerSessionId], references: [id])
  reviewee      User         @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  reviewer      User         @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  studyRoom     StudyRoom?   @relation("StudyRoomReviews", fields: [studyRoomId], references: [id])

  @@index([revieweeId])
  @@index([reviewerId])
  @@index([studyRoomId])
  @@index([peerSessionId])
}

model Skill {
  id           String             @id @default(cuid())
  name         String             @unique
  description  String?
  peerSessions PeerSessionSkill[]
  studyRooms   StudyRoomSkill[]
  userSkills   UserSkill[]
}

model UserSkill {
  id      String @id @default(cuid())
  type    String
  userId  String
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@unique([userId, skillId, type])
}

model StudyRoomSkill {
  id          String    @id @default(cuid())
  studyRoomId String
  skillId     String
  skill       Skill     @relation(fields: [skillId], references: [id])
  studyRoom   StudyRoom @relation(fields: [studyRoomId], references: [id])

  @@unique([studyRoomId, skillId])
}

model PeerSessionSkill {
  id            String      @id @default(cuid())
  peerSessionId String
  skillId       String
  peerSession   PeerSession @relation(fields: [peerSessionId], references: [id])
  skill         Skill       @relation(fields: [skillId], references: [id])

  @@unique([peerSessionId, skillId])
}

model StudyRoomParticipant {
  id          String    @id @default(cuid())
  userId      String
  studyRoomId String
  role        StudyRoomParticipantRole @default(PARTICIPANT)
  studyRoom   StudyRoom @relation(fields: [studyRoomId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, studyRoomId])
  @@index([studyRoomId])
}

model StudyRoomGuestParticipant {
  id          String    @id @default(cuid())
  studyRoomId String
  name        String
  email       String
  role        StudyRoomParticipantRole @default(PARTICIPANT)
  livekitIdentity String @unique
  createdAt   DateTime @default(now())
  approvedBy  String?
  studyRoom   StudyRoom @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)
  accessTokens StudyRoomGuestAccessToken[]

  @@unique([studyRoomId, email])
  @@index([studyRoomId])
}

model StudyRoomGuestAccessToken {
  id          String   @id @default(cuid())
  token       String   @unique
  studyRoomId String
  guestParticipantId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  usedAt      DateTime?
  studyRoom   StudyRoom @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)
  guestParticipant StudyRoomGuestParticipant @relation(fields: [guestParticipantId], references: [id], onDelete: Cascade)

  @@index([studyRoomId])
  @@index([guestParticipantId])
}

/// Attendee registration for webinar-mode study rooms (email + custom answers)
model WebinarRegistration {
  id            String   @id @default(cuid())
  studyRoomId   String
  studyRoom     StudyRoom @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)
  email         String
  name          String
  responses     Json?
  /// Human-readable code emailed to the attendee (with join link) for manual entry
  joinPasscode  String?
  /// Opaque token in the emailed join URL (identifies this registration; passcode required to join)
  joinLinkToken String   @unique
  createdAt     DateTime @default(now())

  @@unique([studyRoomId, email])
  @@index([studyRoomId])
}

model Notification {
  id            String    @id @default(cuid())
  notifType     NotifType
  message       String
  createdAt     DateTime
  viewed        Boolean   @default(false)
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  // Metadata for notification actions
  actionType    String?   // e.g., "SESSION_REQUEST", "SESSION_REMINDER", "REVIEW_REMINDER"
  actionData    String?   // JSON string with sessionId, sessionType, etc.
  peerSessionId String?
  studyRoomId   String?
  peerSession   PeerSession? @relation(fields: [peerSessionId], references: [id])
  studyRoom     StudyRoom?   @relation(fields: [studyRoomId], references: [id])
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String
  p256dh       String
  auth         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

enum SessionStatus {
  UPCOMING
  ONGOING
  CANCELLED
  DONE
  PENDING
  NOT_COMPLETED
}

enum PaymentStatus {
  ESCROW
  REFUNDED
  RECEIVED
}

enum NotifType {
  URGENT
  NORMAL
}

enum StudyRoomRecurrenceMode {
  DAILY
  WEEKLY
  CUSTOM_DATES
}

enum StudyRoomSessionMode {
  STANDARD
  WEBINAR
}

enum StudyRoomParticipantRole {
  PARTICIPANT
  COHOST
}

enum MessageAudienceType {
  EVERYONE
  HOST
  USER
}

model Channel {
  id        String          @id @default(cuid())
  name      String
  isDirect  Boolean         @default(false)
  members   ChannelMember[]
  messages  Message[]
  createdAt DateTime        @default(now())
  externalType String?
  externalId   String?

  @@unique([externalType, externalId])
}

model ChannelMember {
  id        String @id @default(cuid())
  channelId String
  userId    String

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  senderId  String?  // Optional for guest messages
  guestSenderId String? // Guest participant ID for guest messages
  guestEmail String? // Email of guest sender for message history matching
  audienceType MessageAudienceType @default(EVERYONE)
  targetUserId String?
  content   String
  createdAt DateTime @default(now())

  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender    User?    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  targetUser User?   @relation("TargetedMessages", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
  @@index([channelId, targetUserId, createdAt])
  @@index([channelId, guestEmail, createdAt]) // For guest message history lookup
}

model UserAvailability {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int      // 0-6 (Sunday=0, Monday=1, ..., Saturday=6)
  startTime String   // HH:MM format (e.g., "09:00")
  endTime   String   // HH:MM format (e.g., "17:00")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model BlockedTimeSlot {
  id        String   @id @default(cuid())
  userId    String
  startTime DateTime // UTC timestamp for blocked period start
  endTime   DateTime // UTC timestamp for blocked period end
  reason    String?  // Optional reason for blocking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startTime, endTime])
}

model Achievement {
  id               String            @id @default(cuid())
  title            String
  description      String
  icon             String
  category         AchievementCategory
  rarity           AchievementRarity
  maxProgress      Int               @default(1)
  coinReward       Int               @default(0)
  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String       @id @default(cuid())
  userId        String
  achievementId String
  progress      Int          @default(0)
  unlockedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement  @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model DailyActivity {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime // Date normalized to midnight in user's timezone
  sessionCount   Int      @default(0)
  minutesLearned Int      @default(0)
  minutesTaught  Int      @default(0)
  coinsEarned    Decimal  @db.Decimal(36, 16) @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

enum AchievementCategory {
  LEARNING
  TEACHING
  SOCIAL
  MILESTONE
  STREAK
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

// Session Feedback - stores detailed feedback from users after sessions
model SessionFeedback {
  id            String       @id @default(cuid())
  userId        String
  studyRoomId   String?
  peerSessionId String?
  isHost        Boolean      @default(false)
  
  // All questions and answers stored as JSON
  // Contains all 29 questions with their answers
  answers       Json         
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  // Relations
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyRoom     StudyRoom?   @relation(fields: [studyRoomId], references: [id], onDelete: SetNull)
  peerSession   PeerSession? @relation(fields: [peerSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([studyRoomId])
  @@index([peerSessionId])
}

// ==================== DEBATE ROOM FEATURE ====================

// Debate Room - main entity for debate sessions
model DebateRoom {
  id                  String              @id @default(cuid())
  topic               String              // The motion/topic to debate (e.g., "AI is good for humanity")
  description         String?             @db.Text
  status              DebateStatus        @default(WAITING)
  maxParticipants     Int                 @default(6) // Max per team (total = maxParticipants * 2)
  turnDurationSeconds Int                 @default(120) // Default 2 minutes per turn
  prepTimeSeconds     Int                 @default(30) // Prep time before debate starts
  turnOrder           TurnOrderType       @default(FIFO) // FIFO or RANDOM
  debateDurationMinutes Int               @default(60) // Total planned session length (minutes); with scheduledAt sets lobby expiry
  debateSlotEndsAt    DateTime?           // scheduledAt + debateDurationMinutes — listing/join window end
  scheduledAt         DateTime?           // Scheduled start time for the debate
  startTime           DateTime?           // When debate actually starts (after prep)
  endTime             DateTime?           // When debate ends
  currentTurnIndex    Int                 @default(0) // Current position in turn queue
  currentSpeakerId    String?             // Current speaker's user ID
  turnStartedAt       DateTime?           // When current turn started
  
  // Host/Moderator info
  hostId              String              // Creator and head moderator
  
  // LiveKit room name for video
  livekitRoomName     String?
  
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  /// Host saved lobby settings — members see “Edited” + get a notification.
  hostDetailsUpdatedAt DateTime?

  // Relations
  host                User                @relation("DebateRoomHost", fields: [hostId], references: [id])
  teams               DebateTeam[]
  participants        DebateParticipant[]
  moderators          DebateModerator[]
  transcripts         DebateTranscript[]
  reports             DebateReport[]
  turnQueue           DebateTurnQueue[]
  chatMessages        DebateChatMessage[]
  moderatorEvaluations DebateModeratorEvaluation[]
  
  @@index([hostId])
  @@index([status])
}

// Debate Status Enum
enum DebateStatus {
  WAITING     // Lobby phase - users joining
  PREP        // Prep time countdown (30s default)
  LIVE        // Debate in progress
  ENDED       // All turns completed, awaiting results
  PROCESSED   // AI evaluation complete
  CANCELLED   // Debate was cancelled
}

// Turn Order Type
enum TurnOrderType {
  FIFO    // First In First Out - by join time
  RANDOM  // Random order
}

// Debate Team - FOR and AGAINST teams
model DebateTeam {
  id           String              @id @default(cuid())
  debateRoomId String
  side         DebateSide          // FOR or AGAINST
  totalScore   Float?              // Aggregate score after evaluation
  isWinner     Boolean             @default(false)
  
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  
  // Relations
  debateRoom   DebateRoom          @relation(fields: [debateRoomId], references: [id], onDelete: Cascade)
  participants DebateParticipant[]
  
  @@unique([debateRoomId, side])
  @@index([debateRoomId])
}

// Debate Side Enum
enum DebateSide {
  FOR
  AGAINST
}

// Debate Participant - users in debate (not moderators)
model DebateParticipant {
  id              String              @id @default(cuid())
  debateRoomId    String
  teamId          String
  userId          String
  status          ParticipantStatus   @default(ACTIVE)
  joinedAt        DateTime            @default(now())
  turnCompleted   Boolean             @default(false) // Has this user completed their turn?
  disconnectedAt  DateTime?           // When user disconnected (if applicable)
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  // Relations
  debateRoom      DebateRoom          @relation(fields: [debateRoomId], references: [id], onDelete: Cascade)
  team            DebateTeam          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user            User                @relation("DebateParticipant", fields: [userId], references: [id])
  transcripts     DebateTranscript[]
  report          DebateReport?
  turnQueueEntry  DebateTurnQueue?
  moderatorEvaluations DebateModeratorEvaluation[]
  
  @@unique([debateRoomId, userId])
  @@index([debateRoomId])
  @@index([teamId])
  @@index([userId])
}

// Debate Moderator Evaluation - private per moderator, per participant, per turn
model DebateModeratorEvaluation {
  id              String            @id @default(cuid())
  debateRoomId    String
  participantId   String
  moderatorId     String
  turnNumber      Int
  notes           String?           @db.Text
  scores          Json              // Flexible score map: { factorKey: 0-10 }

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  debateRoom      DebateRoom        @relation(fields: [debateRoomId], references: [id], onDelete: Cascade)
  participant     DebateParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  moderator       User              @relation("DebateModeratorEvaluations", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@unique([debateRoomId, participantId, moderatorId, turnNumber])
  @@index([debateRoomId, moderatorId])
  @@index([debateRoomId, participantId])
  @@index([participantId])
}

// Participant Status
enum ParticipantStatus {
  ACTIVE      // Normal active participant
  DISCONNECTED // Temporarily disconnected
  BANNED      // Kicked/banned by moderator
  LEFT        // Voluntarily left
}

// Debate Moderator - up to 3 moderators per room
model DebateModerator {
  id           String     @id @default(cuid())
  debateRoomId String
  userId       String
  isHost       Boolean    @default(false) // True for the original creator
  
  createdAt    DateTime   @default(now())
  
  // Relations
  debateRoom   DebateRoom @relation(fields: [debateRoomId], references: [id], onDelete: Cascade)
  user         User       @relation("DebateModerator", fields: [userId], references: [id])
  
  @@unique([debateRoomId, userId])
  @@index([debateRoomId])
  @@index([userId])
}

// Debate Chat Message - stores all chat messages with visibility rules
model DebateChatMessage {
  id           String          @id @default(cuid())
  debateRoomId String
  senderId     String
  content      String          @db.Text
  side         DebateSide?     // FOR, AGAINST, or null for moderator/global messages
  visibility   MessageVisibility @default(ALL) // Who can see this message
  
  createdAt    DateTime        @default(now())
  
  // Relations
  debateRoom   DebateRoom      @relation(fields: [debateRoomId], references: [id], onDelete: Cascade)
  sender       User            @relation("DebateChatMessages", fields: [senderId], references: [id])
  
  @@index([debateRoomId])
  @@index([senderId])
  @@index([debateRoomId, createdAt])
}

// Message Visibility Enum
enum MessageVisibility {
  ALL              // Everyone can see
  MODERATOR        // From moderators to all participants (broadcast)
  MODERATOR_ONLY   // Private messages between moderators only
  TEAM_FOR         // Only Team FOR + moderators can see
  TEAM_AGAINST     // Only Team AGAINST + moderators can see
}

// Debate Turn Queue - determines speaking order
model DebateTurnQueue {
  id              String            @id @default(cuid())
  debateRoomId    String
  participantId   String            @unique // Each participant has one queue entry
  turnOrder       Int               // 0-indexed position in queue
  completed       Boolean           @default(false)
  skipped         Boolean           @default(false) // True if banned/disconnected
  startedAt       DateTime?
  endedAt         DateTime?
  
  // Relations
  debateRoom      DebateRoom        @relation(fields: [debateRoomId], references: [id], onDelete: Cascade)
  participant     DebateParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  
  @@index([debateRoomId, turnOrder])
}

// Debate Transcript - stores speech-to-text chunks during debate
model DebateTranscript {
  id              String            @id @default(cuid())
  debateRoomId    String
  participantId   String
  turnNumber      Int               // Which turn this belongs to
  text            String            @db.Text
  timestamp       DateTime          @default(now())
  
  // Relations
  debateRoom      DebateRoom        @relation(fields: [debateRoomId], references: [id], onDelete: Cascade)
  participant     DebateParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  
  @@index([debateRoomId])
  @@index([participantId])
  @@index([debateRoomId, turnNumber])
}

// Debate Report - AI-generated evaluation for each participant
model DebateReport {
  id              String            @id @default(cuid())
  debateRoomId    String
  participantId   String            @unique // One report per participant
  
  // Scoring (0-10 scale)
  ideaScore       Float             // Quality of arguments/ideas
  clarityScore    Float             // Clarity of expression
  rebuttalScore   Float             // Quality of rebuttals/counter-arguments
  overallScore    Float             // Weighted overall score
  
  // Feedback
  strengths       Json              // Array of strength points
  weaknesses      Json              // Array of weakness points
  suggestions     Json              // Array of improvement suggestions
  summary         String?           @db.Text // Brief summary of performance
  
  createdAt       DateTime          @default(now())
  
  // Relations
  debateRoom      DebateRoom        @relation(fields: [debateRoomId], references: [id], onDelete: Cascade)
  participant     DebateParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  
  @@index([debateRoomId])
}

model Recording {
  id          String   @id @default(cuid())
  egressId    String   @unique
  roomId      String
  createdById String
  url         String?
  status      String
  isPublic    Boolean  @default(false)
  allowedUsers String[] @default([])
  duration     Int?
  estimatedCost Decimal? @db.Decimal(10, 4)
  autoDeleteAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  room        StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}