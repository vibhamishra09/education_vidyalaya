generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  username              String?                @unique
  email                 String                 @unique
  avatar                String?
  bio                   String?
  location              String?
  school                String?
  coins                 Decimal                @db.Decimal(36, 16) @default(0)
  wallet                String?                // Hedera wallet address
  hourlyRate            Decimal?               @db.Decimal(36, 16)
  clerkId               String                 @unique
  createdAt             DateTime               @default(now())
  onboarded             Boolean                @default(false)
  updatedAt             DateTime               @updatedAt
  // Social media profile links (flexible JSON structure)
  // Format: [{ "platform": "linkedin", "url": "..." }, { "platform": "custom", "label": "My Blog", "url": "..." }]
  socialLinks           Json?
  // Availability settings (Users available 24/7 by default)
  bufferTime            Int                    @default(0) // Minutes between sessions (0 = back-to-back allowed)
  minAdvanceTime        Int                    @default(0) // Minimum minutes before booking (0 = instant booking)
  maxFutureBooking      Int                    @default(365) // Maximum days in future for booking
  // Streak tracking
  currentStreak         Int                    @default(0)
  longestStreak         Int                    @default(0)
  lastActivityDate      DateTime?
  timezone              String                 @default("UTC")
  metrics               Metrics?
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  paymentsMade          Payment[]              @relation("PaymentsMade")
  paymentsReceived      Payment[]              @relation("PaymentsReceived")
  peerSessionsRequested PeerSession[]          @relation("RequestedBy")
  peerSessionsReceived  PeerSession[]          @relation("RequestedTo")
  reviewsReceived       Review[]               @relation("ReviewsReceived")
  reviewsWritten        Review[]               @relation("ReviewsWritten")
  studyRooms            StudyRoom[]            @relation("UserOwnsStudyRooms")
  participating         StudyRoomParticipant[]
  userSkills            UserSkill[]
  channelMemberships ChannelMember[]
  messagesSent       Message[]
  availability          UserAvailability[]
  blockedSlots          BlockedTimeSlot[]
  achievements          UserAchievement[]
  dailyActivities       DailyActivity[]
  sessionFeedbacks      SessionFeedback[]
}

model StudyRoom {
  id              String                 @id @default(cuid())
  title           String
  description     String?
  sessionStatus   SessionStatus
  date            DateTime
  duration        Int
  maxParticipants Int
  createdById     String
  joiningFee      Decimal                @db.Decimal(36, 16) @default(0)
  reviewReminded  Boolean                @default(false)
  reminder24hSent Boolean                @default(false)
  reminder1hSent  Boolean                @default(false)
  reminder5mSent  Boolean                @default(false)
  gmeetLink       String?
  summary         String?                @db.Text
  payments        Payment[]              @relation("StudyRoomPayments")
  reviews         Review[]               @relation("StudyRoomReviews")
  notifications   Notification[]
  createdBy       User                   @relation("UserOwnsStudyRooms", fields: [createdById], references: [id])
  learners        StudyRoomParticipant[]
  skills          StudyRoomSkill[]
  feedbacks       SessionFeedback[]
}

model PeerSession {
  id            String             @id @default(cuid())
  title         String
  description   String?
  sessionStatus SessionStatus
  date          DateTime
  duration      Int
  requestedById String
  requestedToId String
  reviewReminded Boolean           @default(false)
  reminder24hSent Boolean          @default(false)
  reminder1hSent  Boolean          @default(false)
  reminder5mSent  Boolean          @default(false)
  gmeetLink     String?
  summary       String?            @db.Text
  payments      Payment[]          @relation("PeerSessionPayments")
  notifications Notification[]
  requestedBy   User               @relation("RequestedBy", fields: [requestedById], references: [id])
  requestedTo   User               @relation("RequestedTo", fields: [requestedToId], references: [id])
  skills        PeerSessionSkill[]
  reviews       Review[]           @relation("PeerSessionReviews")
  feedbacks     SessionFeedback[]
}

model Metrics {
  id          String  @id @default(cuid())
  name        String
  value       Float
  description String?
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id])
}

model Payment {
  id             String        @id @default(cuid())
  paymentStatus  PaymentStatus
  madeById       String
  receivedById   String
  studyRoomId    String?
  peerSessionId  String?
  amountMade     Decimal                @db.Decimal(36, 16)
  amountReceived Decimal?               @db.Decimal(36, 16)
  amountRefunded Decimal?               @db.Decimal(36, 16)
  createdAt      DateTime               @default(now())
  transactionHash String?
  network         String?
  madeBy         User          @relation("PaymentsMade", fields: [madeById], references: [id])
  peerSession    PeerSession?  @relation("PeerSessionPayments", fields: [peerSessionId], references: [id], map: "Payment_peerSessionId_fkey1")
  receivedBy     User          @relation("PaymentsReceived", fields: [receivedById], references: [id])
  studyRoom      StudyRoom?    @relation("StudyRoomPayments", fields: [studyRoomId], references: [id], map: "Payment_studyRoomId_fkey1")
}

model Review {
  id            String       @id @default(cuid())
  rating        Int
  review        String
  reviewerId    String
  revieweeId    String
  peerSessionId String?
  studyRoomId   String?
  peerSession   PeerSession? @relation("PeerSessionReviews", fields: [peerSessionId], references: [id])
  reviewee      User         @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  reviewer      User         @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  studyRoom     StudyRoom?   @relation("StudyRoomReviews", fields: [studyRoomId], references: [id])
}

model Skill {
  id           String             @id @default(cuid())
  name         String             @unique
  description  String?
  peerSessions PeerSessionSkill[]
  studyRooms   StudyRoomSkill[]
  userSkills   UserSkill[]
}

model UserSkill {
  id      String @id @default(cuid())
  type    String
  userId  String
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@unique([userId, skillId, type])
}

model StudyRoomSkill {
  id          String    @id @default(cuid())
  studyRoomId String
  skillId     String
  skill       Skill     @relation(fields: [skillId], references: [id])
  studyRoom   StudyRoom @relation(fields: [studyRoomId], references: [id])

  @@unique([studyRoomId, skillId])
}

model PeerSessionSkill {
  id            String      @id @default(cuid())
  peerSessionId String
  skillId       String
  peerSession   PeerSession @relation(fields: [peerSessionId], references: [id])
  skill         Skill       @relation(fields: [skillId], references: [id])

  @@unique([peerSessionId, skillId])
}

model StudyRoomParticipant {
  id          String    @id @default(cuid())
  userId      String
  studyRoomId String
  studyRoom   StudyRoom @relation(fields: [studyRoomId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, studyRoomId])
}

model Notification {
  id            String    @id @default(cuid())
  notifType     NotifType
  message       String
  createdAt     DateTime
  viewed        Boolean   @default(false)
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  // Metadata for notification actions
  actionType    String?   // e.g., "SESSION_REQUEST", "SESSION_REMINDER", "REVIEW_REMINDER"
  actionData    String?   // JSON string with sessionId, sessionType, etc.
  peerSessionId String?
  studyRoomId   String?
  peerSession   PeerSession? @relation(fields: [peerSessionId], references: [id])
  studyRoom     StudyRoom?   @relation(fields: [studyRoomId], references: [id])
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String
  p256dh       String
  auth         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

enum SessionStatus {
  UPCOMING
  ONGOING
  CANCELLED
  DONE
  PENDING
  NOT_COMPLETED
}

enum PaymentStatus {
  ESCROW
  REFUNDED
  RECEIVED
}

enum NotifType {
  URGENT
  NORMAL
}

model Channel {
  id        String          @id @default(cuid())
  name      String
  isDirect  Boolean         @default(false)
  members   ChannelMember[]
  messages  Message[]
  createdAt DateTime        @default(now())
  externalType String?
  externalId   String?

  @@unique([externalType, externalId])
}

model ChannelMember {
  id        String @id @default(cuid())
  channelId String
  userId    String

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model UserAvailability {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int      // 0-6 (Sunday=0, Monday=1, ..., Saturday=6)
  startTime String   // HH:MM format (e.g., "09:00")
  endTime   String   // HH:MM format (e.g., "17:00")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model BlockedTimeSlot {
  id        String   @id @default(cuid())
  userId    String
  startTime DateTime // UTC timestamp for blocked period start
  endTime   DateTime // UTC timestamp for blocked period end
  reason    String?  // Optional reason for blocking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startTime, endTime])
}

model Achievement {
  id               String            @id @default(cuid())
  title            String
  description      String
  icon             String
  category         AchievementCategory
  rarity           AchievementRarity
  maxProgress      Int               @default(1)
  coinReward       Int               @default(0)
  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String       @id @default(cuid())
  userId        String
  achievementId String
  progress      Int          @default(0)
  unlockedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement  @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model DailyActivity {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime // Date normalized to midnight in user's timezone
  sessionCount   Int      @default(0)
  minutesLearned Int      @default(0)
  minutesTaught  Int      @default(0)
  coinsEarned    Decimal  @db.Decimal(36, 16) @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

enum AchievementCategory {
  LEARNING
  TEACHING
  SOCIAL
  MILESTONE
  STREAK
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

// Session Feedback - stores detailed feedback from users after sessions
model SessionFeedback {
  id            String       @id @default(cuid())
  userId        String
  studyRoomId   String?
  peerSessionId String?
  isHost        Boolean      @default(false)
  
  // All questions and answers stored as JSON
  // Contains all 29 questions with their answers
  answers       Json         
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  // Relations
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyRoom     StudyRoom?   @relation(fields: [studyRoomId], references: [id], onDelete: SetNull)
  peerSession   PeerSession? @relation(fields: [peerSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([studyRoomId])
  @@index([peerSessionId])
}